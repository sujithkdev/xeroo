# Generate independent hex secrets. Never commit deploy/.env.
POSTGRES_PASSWORD=
APP_DOMAIN=techpickhub.shop
LOCAL_DB_MODE=false
LOCAL_OPERATOR_MODE=false
# 64 hex characters; see src/lib/payment-context.ts
PAYMENTS_ENCRYPTION_KEY=
# Initially leave S3 settings unset: the private documents volume is used.
