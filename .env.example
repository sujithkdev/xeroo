# ─────────────────────────────────────────────────────────────────────────────
# Krishna Print Hub — Environment Variables
# 
# SETUP INSTRUCTIONS:
#   1. Copy this file to .env.local
#   2. Fill in the values below
#   3. Run setup.bat to install and build
#   4. Run START.bat to launch
# ─────────────────────────────────────────────────────────────────────────────

# ── Required for local single-shop mode ──────────────────────────────────────

# Enables local single-shop mode (no PostgreSQL needed)
LOCAL_OPERATOR_MODE=true

# Agent token — MUST be a random 64-character hex string
# Generate one by running this command in terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN=REPLACE_WITH_64_CHAR_HEX_TOKEN

# Backend URL — where the web server runs (don't change unless you change PORT)
BACKEND_URL=http://127.0.0.1:3000

# ── Optional settings ─────────────────────────────────────────────────────────

# Port for the web server (default: 3000)
# PORT=3000

# Where to store the database and uploaded files (default: ./data)
# DATA_DIR=./data

# ── Online payments (Razorpay) — optional ────────────────────────────────────
# Only needed if you want to accept online payments.
# Get these from https://dashboard.razorpay.com
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── WhatsApp PDF intake — optional ───────────────────────────────────────────
# Only needed if you want customers to send PDFs via WhatsApp.
# WHATSAPP_APP_SECRET=your_app_secret
# WHATSAPP_GRAPH_VERSION=v19.0

# ── Multi-shop PostgreSQL mode — optional ────────────────────────────────────
# Only needed if running multiple shops. Leave blank for single-shop mode.
# DATABASE_URL=postgresql://user:password@localhost:5432/krishna_print_hub
# PAYMENTS_ENCRYPTION_KEY=64_char_hex_key_for_encrypting_payment_secrets
# APP_DOMAIN=yourdomain.com
